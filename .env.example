# ==============================================================================
# LLM Provider Selection: 'ollama', 'groq', or 'gemini'
# ==============================================================================
LLM_PROVIDER=groq

# --- Option A: Free Cloud API (Groq) ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=groq/llama-3.3-70b-versatile

# --- Option B: Free Cloud API (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini/gemini-3.6-flash

# --- Option C: Local Offline Inference (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama/llama3.1:8b

# Optional: Disable anonymous telemetry in CrewAI
OTEL_SDK_DISABLED=true
CREWAI_TELEMETRY_OPT_OUT=true